<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <title>Your Signup Verification Code - QuickMedic</title>
    <style>
        body {
            margin: 0;
            padding: 0;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Arial, sans-serif;
        }

        img {
            border: 0;
            display: block;
        }

        @media only screen and (max-width: 600px) {
            .mobile-padding {
                padding: 20px 15px !important;
            }

            .otp-digit {
                font-size: 36px !important;
                padding: 10px !important;
            }
        }
    </style>
</head>

<body style="margin: 0; padding: 0; background-color: #24A197;">
    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%"
        style="background: #0a0e27; background-image: radial-gradient(circle at 20% 50%, rgba(59, 89, 152, 0.15) 0%, transparent 50%), radial-gradient(circle at 80% 80%, rgba(22, 184, 157, 0.15) 0%, transparent 50%); min-height: 100vh;">
        <tr>
            <td style="padding: 60px 20px;">
                <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="480"
                    style="margin: 0 auto; background-color: #ffffff; border-radius: 24px; box-shadow: 0 20px 60px rgba(0,0,0,0.3);"
                    class="mobile-padding">
                    <!-- Logo/Icon -->
                    <tr>
                        <td style="padding: 50px 40px 30px; text-align: center;">
                            <table role="presentation" cellspacing="0" cellpadding="0" border="0"
                                style="margin: 0 auto;">
                                <tr>
                                    {{!-- <td
                                        style="width: 80px; height: 80px; background-color: #2c3e50; border-radius: 16px; text-align: center; vertical-align: middle;">
                                        <span
                                            style="color: #7CB342; font-size: 28px; font-weight: bold; line-height: 80px;">Quick</span>
                                    </td> --}}
                                    <td>
                                        <img src="{{baseUrl}}/images/logo.png" alt="QuickMedic Logo" width="120"
                                            style="display: block;">
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>

                    <!-- Title -->
                    <tr>
                        <td style="padding: 0 40px 30px;">
                            <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
                                <tr>
                                    <td
                                        style="font-size: 22px; font-weight: 600; color: #1a1a1a; text-align: center; line-height: 30px;">
                                        Your Signup verification<br>Code
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>

                    <!-- OTP Code -->

                    <tr>
                        <td style="padding: 0 40px 30px;">
                            <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
                                <tr>
                                    <td style="text-align: center;">
                                        <table role="presentation" cellspacing="8" cellpadding="0" border="0"
                                            style="margin: 0 auto;">
                                            <tr>
                                                {{#each otpDigits}}
                                                <td
                                                    style="width: 50px; height: 60px; background-color: #f5f5f5; border-radius: 12px; text-align: center; vertical-align: middle;">
                                                    <span
                                                        style="font-size: 32px; font-weight: 600; color: #1a1a1a; font-family: 'Courier New', monospace;">
                                                        {{this}}
                                                    </span>
                                                </td>
                                                {{/each}}
                                            </tr>
                                        </table>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>


                    <!-- Warning Text -->
                    <tr>
                        <td style="padding: 0 40px 30px;">
                            <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
                                <tr>
                                    <td style="font-size: 14px; color: #999999; text-align: center;">
                                        Don't share this code to anyone!
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>

                    <!-- Alert Box -->
                    <tr>
                        <td style="padding: 0 40px 30px;">
                            <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
                                <tr>
                                    <td
                                        style="background-color: #fff8e1; border-left: 3px solid #ff9800; padding: 16px 20px; border-radius: 8px;">
                                        <table role="presentation" cellspacing="0" cellpadding="0" border="0"
                                            width="100%">
                                            <tr>
                                                <td style="width: 24px; vertical-align: top; padding-right: 12px;">
                                                    <span style="font-size: 20px; color: #ff9800;">⚠️</span>
                                                </td>
                                                <td style="vertical-align: top;">
                                                    <p
                                                        style="margin: 0 0 8px 0; font-size: 14px; font-weight: 600; color: #1a1a1a;">
                                                        Was this request not made by you?
                                                    </p>
                                                    <p
                                                        style="margin: 0; font-size: 13px; color: #666666; line-height: 18px;">
                                                        This code was generated from a request made using
                                                        {{browserName}} browser on <strong>{{deviceOS}}</strong> on
                                                        <strong>{{requestDate}}</strong> Aft. If you did not initiate
                                                        this request, you can safely <a href="#"
                                                            style="color: #1a1a1a; font-weight: 600; text-decoration: none;">ignore
                                                            this email</a>.
                                                    </p>
                                                </td>
                                            </tr>
                                        </table>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>

                    <!-- Footer Notice -->
                    <tr>
                        <td style="padding: 0 40px 30px;">
                            <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
                                <tr>
                                    <td style="font-size: 13px; color: #999999; text-align: center; line-height: 18px;">
                                        This is an automated message. <strong style="color: #1a1a1a;">Please do not
                                            reply.</strong>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>

                    <!-- IP Address -->
                    {{#if ipAddress}}
                    <tr>
                        <td style="padding: 0 40px 40px;">
                            <table role="presentation" cellspacing="0" cellpadding="0" border="0"
                                style="margin: 0 auto;">
                                <tr>
                                    <td style="background-color: #24A197; border-radius: 20px; padding: 8px 16px;">
                                        <span style="font-size: 12px; color: #ffffff;">● IP &nbsp; {{ipAddress}}</span>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                    {{/if }}
                </table>

                <!-- Footer outside card -->
                <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="480"
                    style="margin: 40px auto 0;" class="mobile-padding">
                    {{!-- <tr>
                        <td style="text-align: center; padding-bottom: 20px;">
                            <table role="presentation" cellspacing="0" cellpadding="0" border="0"
                                style="margin: 0 auto;">
                                <tr>
                                    <td style="padding: 0 10px;">
                                        <a href="{{facebookUrl}}"
                                            style="display: inline-block; width: 40px; height: 40px; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); border-radius: 50%; text-align: center; line-height: 40px; text-decoration: none;">
                                            <span style="color: #ffffff; font-size: 16px;">f</span>
                                        </a>
                                    </td>
                                    <td style="padding: 0 10px;">
                                        <a href="{{instagramUrl}}"
                                            style="display: inline-block; width: 40px; height: 40px; background: linear-gradient(135deg, #f09433 0%, #e6683c 25%, #dc2743 50%, #cc2366 75%, #bc1888 100%); border-radius: 50%; text-align: center; line-height: 40px; text-decoration: none;">
                                            <span style="color: #ffffff; font-size: 16px;">📷</span>
                                        </a>
                                    </td>
                                    <td style="padding: 0 10px;">
                                        <a href="{{tiktokUrl}}"
                                            style="display: inline-block; width: 40px; height: 40px; background: linear-gradient(135deg, #00f2ea 0%, #ff0050 100%); border-radius: 50%; text-align: center; line-height: 40px; text-decoration: none;">
                                            <span style="color: #ffffff; font-size: 16px;">♪</span>
                                        </a>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr> --}}
                    <tr>
                        <td style="text-align: center; padding-bottom: 10px;">
                            <p style="margin: 0; font-size: 13px; color: #8892a6; line-height: 20px;">
                                All rights reserved to the <strong style="color: #ffffff;">QuickMedic</strong> platform
                                © {{currentYear}}.
                            </p>
                        </td>
                    </tr>
                    <tr>
                        <td style="text-align: center;">
                            <p style="margin: 0; font-size: 13px; color: #8892a6;">
                                Email: <a href="mailto:{{supportEmail}}"
                                    style="color: #667eea; text-decoration: none;">{{supportEmail}}</a> &nbsp;&nbsp;
                              </p>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</body>

</html>