{
  "info": {
    "name": "experience_1 Auth & Profile",
    "_postman_id": "experience1-auth-profile-collection",
    "description": "API collection for experience_1 auth, consumer profile onboarding, and doctor onboarding.\n\n## Setup\n1. Import this collection first\n2. Use the collection variables or matching environment values\n3. Run one auth flow at a time\n4. The latest successful login, doctor registration, or consumer signup completion overwrites the shared `token` and `refreshToken`\n\n## Recommended Test Flow\n### Consumer\n1. Request Signup OTP\n2. Verify Signup OTP\n3. Complete Consumer Signup\n4. Get Current User\n5. Create Consumer Profile\n6. Upload Consumer Profile Image\n7. Get Consumer Profile\n\n### Doctor\n1. Register Doctor\n2. Get Current User\n3. Create Doctor Basic Profile\n4. Upload Doctor Profile Image\n5. Add Doctor Address\n6. Add Education History\n7. Add Work History\n8. Create Doctor Specialties\n9. Complete Doctor Onboarding\n10. Get Doctor Profile",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:6200/api/v1/main"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "refreshToken",
      "value": ""
    },
    {
      "key": "consumer_email",
      "value": "consumer1@example.com"
    },
    {
      "key": "consumer_phone",
      "value": "+2348012345678"
    },
    {
      "key": "consumer_password",
      "value": "StrongPass1!"
    },
    {
      "key": "doctor_email",
      "value": "doctor1@example.com"
    },
    {
      "key": "doctor_phone",
      "value": "+2348099999999"
    },
    {
      "key": "doctor_password",
      "value": "StrongPass1!"
    },
    {
      "key": "doctor_license",
      "value": "LIC-12345"
    },
    {
      "key": "signup_session_id",
      "value": ""
    },
    {
      "key": "forgot_session_id",
      "value": ""
    },
    {
      "key": "otp_code",
      "value": ""
    },
    {
      "key": "education_id",
      "value": ""
    },
    {
      "key": "work_id",
      "value": ""
    },
    {
      "key": "speciality_id_1",
