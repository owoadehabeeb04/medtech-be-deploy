        <mxCell id="s-orders" value="D3 Orders and order items&#xa;in-store sale snapshots" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#edf8ed;strokeColor=#41844a;fontSize=12;" vertex="1" parent="1"><mxGeometry x="850" y="400" width="220" height="75" as="geometry"/></mxCell>
        <mxCell id="s-read" value="P3 Sale list/detail/export APIs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#315a9a;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1120" y="300" width="220" height="75" as="geometry"/></mxCell>
        <mxCell id="s-push" value="P4 Best-effort notification&#xa;after commit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#315a9a;fontSize=13;" vertex="1" parent="1"><mxGeometry x="520" y="80" width="220" height="65" as="geometry"/></mxCell>
        <mxCell id="s-devices" value="D5 Preferences and&#xa;active device tokens" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#edf8ed;strokeColor=#41844a;fontSize=12;" vertex="1" parent="1"><mxGeometry x="820" y="60" width="220" height="70" as="geometry"/></mxCell>
