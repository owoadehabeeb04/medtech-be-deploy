        <mxCell id="w-settle" value="P3 Verify webhook/callback&#xa;and settle idempotently" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#315a9a;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1030" y="280" width="230" height="80" as="geometry"/></mxCell>
        <mxCell id="w-push" value="P4 Best-effort funding push&#xa;after successful settlement" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#315a9a;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1300" y="100" width="220" height="70" as="geometry"/></mxCell>
        <mxCell id="w-devices" value="D5 Preferences and&#xa;active device tokens" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#edf8ed;strokeColor=#41844a;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1300" y="300" width="220" height="70" as="geometry"/></mxCell>
        <mxCell id="w-fcm" value="Firebase Cloud Messaging" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff7e6;strokeColor=#9a6700;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1300" y="500" width="220" height="65" as="geometry"/></mxCell>
        <mxCell id="w-note" value="Paystack webhook signatures are verified over the captured raw body. The authenticated confirm-funding path verifies the reference with Paystack. Both converge on one idempotent settlement; FCM failure does not undo a successful credit." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fillColor=none;strokeColor=none;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="30" y="680" width="1450" height="65" as="geometry"/></mxCell>
        <mxCell id="we1" value="Amount / authenticated request" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="w-portal" target="w-fund"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="we2" value="Create pending transaction" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="w-fund" target="w-init"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="we3" value="Persist reference/status" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="w-init" target="w-db"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="we4" value="Initialize payment" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="w-init" target="w-paystack"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="we5" value="Authorization URL / reference" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="w-init" target="w-portal"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="we6" value="Complete hosted checkout" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="w-portal" target="w-paystack"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="we7" value="Signed raw-body webhook" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="w-paystack" target="w-settle"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="we8" value="Confirm endpoint verifies reference" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="w-settle" target="w-paystack"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="we9" value="Credit wallet / mark success once" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="w-settle" target="w-db"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="we10" value="After settlement" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="w-settle" target="w-push"><mxGeometry relative="1" as="geometry"/></mxCell>
