  <diagram id="merchant-push" name="Push Notification Setup and Delivery">
    <mxGraphModel dx="1450" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1450" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="p-portal" value="Merchant Portal Browser&#xa;service worker" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff7e6;strokeColor=#9a6700;fontSize=14;" vertex="1" parent="1"><mxGeometry x="30" y="320" width="200" height="75" as="geometry"/></mxCell>
        <mxCell id="p-setup" value="P1 Device-token and&#xa;notification-settings APIs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#315a9a;fontSize=13;" vertex="1" parent="1"><mxGeometry x="320" y="320" width="230" height="75" as="geometry"/></mxCell>
        <mxCell id="p-store" value="D5 Merchant settings&#xa;preferences and device tokens" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#edf8ed;strokeColor=#41844a;fontSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="320" width="240" height="75" as="geometry"/></mxCell>
        <mxCell id="p-event" value="P2 Committed business event&#xa;new order / wallet funded / offline sale" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#315a9a;fontSize=13;" vertex="1" parent="1"><mxGeometry x="30" y="100" width="250" height="75" as="geometry"/></mxCell>
        <mxCell id="p-dispatch" value="P3 Check global/event preference&#xa;load active tokens and send" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#315a9a;fontSize=13;" vertex="1" parent="1"><mxGeometry x="360" y="100" width="250" height="75" as="geometry"/></mxCell>
        <mxCell id="p-fcm" value="Firebase Cloud Messaging" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff7e6;strokeColor=#9a6700;fontSize=14;" vertex="1" parent="1"><mxGeometry x="720" y="100" width="220" height="70" as="geometry"/></mxCell>
        <mxCell id="p-browser" value="P4 Browser receives web push&#xa;and displays notification" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#315a9a;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1050" y="100" width="240" height="70" as="geometry"/></mxCell>
        <mxCell id="p-note" value="Business data is committed before notification delivery is attempted. Delivery can be skipped by preferences, no active devices, or Firebase configuration, and failures do not undo the order, sale, or wallet credit." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fillColor=none;strokeColor=none;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="30" y="560" width="1260" height="65" as="geometry"/></mxCell>
        <mxCell id="pe1" value="FCM token, device ID, preferences" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="p-portal" target="p-setup"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="pe2" value="Persist/update registration and preferences" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="p-setup" target="p-store"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="pe3" value="Merchant ID and event payload" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="p-event" target="p-dispatch"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="pe4" value="Preferences and active device tokens" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="p-store" target="p-dispatch"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="pe5" value="Title, body and string data payload" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="p-dispatch" target="p-fcm"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="pe6" value="Web push delivery" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="p-fcm" target="p-browser"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="pe7" value="Display / click navigation" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="p-browser" target="p-portal"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="pe8" value="Push status / test request" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="p-portal" target="p-setup"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
