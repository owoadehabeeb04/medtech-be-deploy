        <mxCell id="s-note" value="The service checks inventory and writes stock changes, the sale order, and line-item snapshots in one transaction. Push is attempted after commit; a failed push does not roll back the sale." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fillColor=none;strokeColor=none;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="30" y="610" width="1280" height="65" as="geometry"/></mxCell>
        <mxCell id="se1" value="Sale items and payment details" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="s-portal" target="s-api"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="se2" value="Validated request" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="s-api" target="s-tx"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="se3" value="Decrement stock" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="s-tx" target="s-catalog"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="se12" value="Current product and stock data" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="s-catalog" target="s-tx"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="se4" value="Create sale and item snapshots" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="s-tx" target="s-orders"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="se5" value="Sale records" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="s-orders" target="s-read"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="se6" value="List/detail/export request" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="s-portal" target="s-read"><mxGeometry relative="1" as="geometry"/></mxCell>
