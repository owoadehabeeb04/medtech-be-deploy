      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="merchant-offline-sale" name="Offline Sale">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="s-portal" value="Merchant Portal" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff7e6;strokeColor=#9a6700;fontSize=14;" vertex="1" parent="1"><mxGeometry x="30" y="310" width="170" height="65" as="geometry"/></mxCell>
        <mxCell id="s-api" value="P1 Authenticated&#xa;in-store sale API" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#315a9a;fontSize=13;" vertex="1" parent="1"><mxGeometry x="260" y="300" width="200" height="75" as="geometry"/></mxCell>
