{
	"compilerOptions": {
		"target": "es6",
		"module": "commonjs",
		"strict": true,
		"paths": {
			"@medtech/utils": ["./utils/dist/index.d.ts", "./utils/src/index.ts"],
			"@medtech/utils/*": ["./utils/dist/*", "./utils/src/*"]
		},
		"esModuleInterop": true,
		"skipLibCheck": true,
		"strictNullChecks": false,
		"resolveJsonModule": true,
		"experimentalDecorators": true,
		"noImplicitAny": true,
		"forceConsistentCasingInFileNames": true
	}
}
