DOMAIN_VAR=hello_from_merchant
BASE_API_URL=http://localhost:3000
ALLOWED_PAYMENT_RETURN_ORIGINS=http://localhost:5173,https://your-app.vercel.app

# Set true only when you explicitly need Sequelize to alter the local schema.
DB_SYNC_ALTER=false

# Service-to-service request rate limit (kept separate from public traffic)
INTERNAL_RATE_LIMIT_DURATION=60000
INTERNAL_RATE_LIMIT_MAX_REQUESTS=1000

# Support Contact Information
SUPPORT_EMAIL=support@meditechhealth.ng
SUPPORT_PHONE=+2348051114444
SUPPORT_ADDRESS=14 Haruna Ishola Street, Lagos. Nigeria

# JWT Refresh Token Configuration
JWT_REFRESH_SECRET=your-refresh-token-secret-here
JWT_REFRESH_EXPIRES_IN=30d

# Firebase Admin / Firebase Cloud Messaging (server-side only)
# Use either the three FIREBASE_* values below or GOOGLE_APPLICATION_CREDENTIALS.
# Never expose the private key or service-account JSON to the frontend.
FIREBASE_PROJECT_ID=quickmedic-2e4d5
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_SERVICE_ACCOUNT_JSON=
