DOMAIN_VAR=hello_from_merchant
BASE_API_URL=http://localhost:3000
ALLOWED_PAYMENT_RETURN_ORIGINS=http://localhost:5173,https://your-app.vercel.app

# Set true only when you explicitly need Sequelize to alter the local schema.
DB_SYNC_ALTER=false

# Service-to-service request rate limit (kept separate from public traffic)
INTERNAL_RATE_LIMIT_DURATION=60000
INTERNAL_RATE_LIMIT_MAX_REQUESTS=1000

# Support Contact Information
SUPPORT_EMAIL=support@meditechhealth.ng
SUPPORT_PHONE=+2348051114444
SUPPORT_ADDRESS=14 Haruna Ishola Street, Lagos. Nigeria

# JWT Refresh Token Configuration
JWT_REFRESH_SECRET=your-refresh-token-secret-here
JWT_REFRESH_EXPIRES_IN=30d

# Firebase Admin / Firebase Cloud Messaging (server-side only)
# Use either the three FIREBASE_* values below or GOOGLE_APPLICATION_CREDENTIALS.
# Never expose the private key or service-account JSON to the frontend.
FIREBASE_PROJECT_ID=quickmedic-2e4d5
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_SERVICE_ACCOUNT_JSON=

# Google Geocoding API (server-side only). Verifies store addresses and stores their coordinates.
GOOGLE_MAPS_API_KEY=
# Fallback nearby-pharmacy radius (km) for merchants who haven't set a delivery radius
NEARBY_DEFAULT_RADIUS_KM=10
UPLOAD_MAX_FILE_SIZE_MB=10

# Where staff invitation links point (the merchant web app)
MERCHANT_APP_URL=http://localhost:5173
INVITATION_EXPIRY_DAYS=7

# --- Paga (payments) ---------------------------------------------------------------------------
# test = sandbox account (beta); live = real money. Use SEPARATE keys per environment. Never put live keys on Render.
PAGA_ENV=test
# Business Portal > Developer Tools > API Keys
PAGA_PUBLIC_KEY=
PAGA_SECRET_KEY=
PAGA_HASH_KEY=
# Business API (bank list, account-name check, payouts). Paga's docs call the public key the principal and the
# secret key the credentials: leave these two EMPTY to reuse PAGA_PUBLIC_KEY / PAGA_SECRET_KEY.
PAGA_BUSINESS_PRINCIPAL=
PAGA_BUSINESS_CREDENTIALS=
# Optional: override the Business API base URL (local testing against a fake)
PAGA_BUSINESS_URL=
PAGA_TIMEOUT_MS=20000
# Optional overrides of the Checkout hosts (local testing against a fake)
PAGA_CHECKOUT_URL=
PAGA_CHECKOUT_VERIFY_URL=
# Public address of THIS backend. Paga posts payment webhooks to {PUBLIC_BASE_URL}/api/v1/merchant/payments/paga/webhook
# and its IP must be whitelisted for Checkout. Must be reachable from the internet.
PUBLIC_BASE_URL=
# paga (default) or paystack (emergency fallback for NEW wallet fundings)
PAYMENT_PROVIDER_WALLET_FUNDING=paga
# Withdrawals (wallet -> merchant's bank account): paga (default) or paystack (emergency fallback)
PAYMENT_PROVIDER_WITHDRAWALS=paga
# Smallest withdrawal, in naira. Paga's fee is added on top and paid by the merchant.
WITHDRAWAL_MIN_NAIRA=1000
# Where operational alerts go (Paga balance too low, payout stuck). Empty = logged only.
OPS_ALERT_EMAIL=
# Alert when the Paga business balance (payouts are paid from it) falls below this many naira. 0 = off.
PAGA_LOW_BALANCE_ALERT_NAIRA=0
# A payout still unresolved after this many hours raises an alert
WITHDRAWAL_STUCK_ALERT_HOURS=6
# Background check of pending payments (credits paid ones whose webhook never arrived, expires abandoned ones)
PAYMENT_SWEEPER_ENABLED=true
PAYMENT_SWEEPER_INTERVAL_SECONDS=300
PAYMENT_SWEEPER_MIN_AGE_SECONDS=120
PAYMENT_PENDING_EXPIRY_HOURS=24
PAYMENT_LATE_SUCCESS_DAYS=7
# validateDepositToBank needs an amount for name lookups (naira); confirm the right value with Paga
PAGA_NAME_LOOKUP_AMOUNT_NAIRA=100
PAGA_BANK_LIST_CACHE_HOURS=6
# paga (default) or paystack (emergency fallback only)
PAYMENT_PROVIDER_BANK_VERIFICATION=paga
BANK_VERIFY_MAX_ATTEMPTS=10
BANK_VERIFY_WINDOW_MINUTES=10
# Converts merchants' saved Paystack bank codes to Paga ones, once, in the background after startup.
# OFF unless set to true. Turn on only after reviewing a dry run: npm run migrate:bank-codes -- --verify
AUTO_BANK_CODE_MIGRATION=false
