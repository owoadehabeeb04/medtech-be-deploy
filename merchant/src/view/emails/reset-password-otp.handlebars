<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Password Reset Verification Code</title>
    <style>
        body { margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Arial, sans-serif; }
        img { border: 0; display: block; }
        @media only screen and (max-width: 600px) {
            .mobile-padding { padding: 20px 15px !important; }
            .otp-digit { font-size: 36px !important; padding: 10px !important; }
        }
    </style>
</head>
<body style="margin: 0; padding: 0; background-color: #f5f5f5;">
    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="background: #f5f5f5; min-height: 100vh;">
        <tr>
            <td style="padding: 40px 20px;">
                <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="600" style="margin: 0 auto; background-color: #ffffff; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1);" class="mobile-padding">
                    <tr>
                        <td style="padding: 40px 40px 30px; text-align: center; border-bottom: 3px solid #24A197;">
                            <table role="presentation" cellspacing="0" cellpadding="0" border="0" style="margin: 0 auto;">
                                <tr>
                                    <td style="font-size: 24px; font-weight: 700; color: #24A197; letter-spacing: -0.5px;">QuickMedic</td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                    <tr>
                        <td style="padding: 40px 40px 20px;">
                            <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
                                <tr>
                                    <td style="font-size: 24px; font-weight: 600; color: #1a1a1a; line-height: 32px; padding-bottom: 10px;">Password Reset Verification Code</td>
                                </tr>
                                <tr>
                                    <td style="font-size: 16px; color: #666666; line-height: 24px; padding-bottom: 30px;">Please use the code below to reset your password.</td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                    <tr>
                        <td style="padding: 0 40px 30px;">
                            <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
                                <tr>
                                    <td style="text-align: center;">
                                        <table role="presentation" cellspacing="12" cellpadding="0" border="0" style="margin: 0 auto;">
                                            <tr>
                                                {{#each otpDigits}}
                                                <td style="width: 56px; height: 64px; background-color: #f8f9fa; border: 2px solid #e9ecef; border-radius: 8px; text-align: center; vertical-align: middle;">
                                                    <span style="font-size: 32px; font-weight: 600; color: #24A197; font-family: 'Courier New', monospace; line-height: 60px;">{{this}}</span>
                                                </td>
                                                {{/each}}
                                            </tr>
                                        </table>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                    <tr>
                        <td style="padding: 0 40px 30px;">
                            <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
                                <tr>
                                    <td style="font-size: 14px; color: #999999; text-align: center; line-height: 20px;">Do not share this code with anyone. QuickMedic will never ask for this code.</td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                    <tr>
                        <td style="padding: 0 40px 30px;">
                            <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
                                <tr>
                                    <td style="background-color: #f8f9fa; border-left: 4px solid #24A197; padding: 16px 20px; border-radius: 4px;">
                                        <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
                                            <tr>
                                                <td style="vertical-align: top;">
                                                    <p style="margin: 0 0 8px 0; font-size: 14px; font-weight: 600; color: #1a1a1a;">Security Notice</p>
                                                    <p style="margin: 0; font-size: 13px; color: #666666; line-height: 20px;">This code was requested from {{browserName}} on {{deviceOS}} on {{requestDate}}. If you did not make this request, please ignore this email.</p>
                                                </td>
                                            </tr>
                                        </table>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                    {{#if ipAddress}}
                    <tr>
                        <td style="padding: 0 40px 30px;">
                            <table role="presentation" cellspacing="0" cellpadding="0" border="0" style="margin: 0 auto;">
                                <tr>
                                    <td style="background-color: #24A197; border-radius: 4px; padding: 6px 12px;">
                                        <span style="font-size: 12px; color: #ffffff; font-weight: 500;">IP Address: {{ipAddress}}</span>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                    {{/if}}
                    <tr>
                        <td style="padding: 30px 40px; background-color: #f8f9fa; border-top: 1px solid #e9ecef; border-radius: 0 0 8px 8px;">
                            <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
                                <tr>
                                    <td style="font-size: 12px; color: #999999; text-align: center; line-height: 18px;">
                                        <p style="margin: 0 0 8px 0;">This is an automated message. Please do not reply.</p>
                                        <p style="margin: 0;">© {{currentYear}} QuickMedic. All rights reserved.</p>
                                        <p style="margin: 8px 0 0 0;">Need help? Contact us at <a href="mailto:{{supportEmail}}" style="color: #24A197; text-decoration: none;">{{supportEmail}}</a></p>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</body>
</html>
