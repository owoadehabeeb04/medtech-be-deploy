<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Password Reset Code</title>
</head>
<body style="margin:0;padding:0;background:#f5f7fa;font-family:Arial,sans-serif;color:#1f2937;">
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="background:#f5f7fa;padding:32px 16px;">
        <tr>
            <td align="center">
                <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="max-width:560px;background:#ffffff;border:1px solid #e5e7eb;border-radius:12px;">
                    <tr>
                        <td style="padding:32px 32px 16px;">
                            <h1 style="margin:0;font-size:22px;line-height:30px;color:#111827;">Your password reset code</h1>
                        </td>
                    </tr>
                    <tr>
                        <td style="padding:0 32px 16px;font-size:15px;line-height:24px;color:#4b5563;">
                            Use this code to reset your merchant account password.
                        </td>
                    </tr>
                    <tr>
                        <td align="center" style="padding:8px 32px 24px;">
                            <table role="presentation" cellspacing="8" cellpadding="0" border="0">
                                <tr>
                                    {{#each otpDigits}}
                                    <td align="center" style="min-width:44px;height:52px;border:1px solid #d1d5db;border-radius:8px;background:#f9fafb;font-size:28px;font-weight:700;color:#111827;">
                                        {{this}}
                                    </td>
                                    {{/each}}
                                </tr>
                            </table>
                        </td>
                    </tr>
                    <tr>
                        <td style="padding:0 32px 20px;font-size:14px;line-height:22px;color:#6b7280;">
                            Do not share this code with anyone. If you did not request it, you can ignore this email.
                        </td>
                    </tr>
                    {{#if ipAddress}}
                    <tr>
                        <td style="padding:0 32px 20px;">
                            <div style="padding:12px 14px;background:#f9fafb;border:1px solid #e5e7eb;border-radius:8px;font-size:13px;line-height:20px;color:#4b5563;">
                                Request details: {{browserName}} on {{deviceOS}}{{#if requestDate}} on {{requestDate}}{{/if}}. IP: {{ipAddress}}
                            </div>
                        </td>
                    </tr>
                    {{/if}}
                    <tr>
                        <td style="padding:20px 32px 32px;border-top:1px solid #e5e7eb;font-size:12px;line-height:20px;color:#6b7280;">
                            Support: <a href="mailto:{{supportEmail}}" style="color:#0f766e;text-decoration:none;">{{supportEmail}}</a><br>
                            This is an automated email. Please do not reply.<br>
                            &copy; {{currentYear}} QuickMedic
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</body>
</html>
