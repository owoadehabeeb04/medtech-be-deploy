<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>New Support Request</title>
</head>
<body style="margin:0;padding:0;background:#f5f7fa;font-family:Arial,sans-serif;color:#1f2937;">
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="background:#f5f7fa;padding:32px 16px;">
        <tr>
            <td align="center">
                <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="max-width:560px;background:#ffffff;border:1px solid #e5e7eb;border-radius:12px;">
                    <tr>
                        <td style="padding:32px 32px 16px;">
                            <h1 style="margin:0;font-size:22px;line-height:30px;color:#111827;">New support request</h1>
                        </td>
                    </tr>
                    <tr>
                        <td style="padding:0 32px 16px;font-size:15px;line-height:24px;color:#4b5563;">
                            A merchant has submitted a new support request.
                        </td>
                    </tr>
                    <tr>
                        <td style="padding:0 32px 20px;">
                            <div style="padding:16px;background:#f9fafb;border:1px solid #e5e7eb;border-radius:8px;">
                                <div style="font-size:14px;line-height:22px;color:#111827;"><strong>Merchant:</strong> {{merchantName}}</div>
                                <div style="font-size:14px;line-height:22px;color:#4b5563;"><strong>Email:</strong> {{merchantEmail}}</div>
                                <div style="font-size:14px;line-height:22px;color:#4b5563;"><strong>Merchant ID:</strong> {{merchantId}}</div>
                                <div style="margin-top:12px;font-size:14px;line-height:22px;color:#111827;"><strong>Subject:</strong> {{subject}}</div>
                                <div style="margin-top:10px;font-size:14px;line-height:22px;color:#4b5563;"><strong>Message:</strong></div>
                                <div style="margin-top:6px;font-size:14px;line-height:22px;color:#4b5563;">{{message}}</div>
                                <div style="margin-top:12px;font-size:13px;line-height:20px;color:#6b7280;"><strong>Submitted:</strong> {{timestamp}}</div>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td style="padding:20px 32px 32px;border-top:1px solid #e5e7eb;font-size:12px;line-height:20px;color:#6b7280;">
                            This is an automated support notification from QuickMedic.<br>
                            &copy; {{currentYear}} QuickMedic
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</body>
</html>
