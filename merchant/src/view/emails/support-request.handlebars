<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>New Support Request</title>
    <style>
        body { margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Arial, sans-serif; }
        @media only screen and (max-width: 600px) {
            .mobile-padding { padding: 20px 15px !important; }
        }
    </style>
</head>
<body style="margin: 0; padding: 0; background-color: #f5f5f5;">
    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="background: #f5f5f5; min-height: 100vh;">
        <tr>
            <td style="padding: 40px 20px;">
                <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="600" style="margin: 0 auto; background-color: #ffffff; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1);" class="mobile-padding">
                    <tr>
                        <td style="padding: 40px 40px 30px; text-align: center; border-bottom: 3px solid #24A197;">
                            <table role="presentation" cellspacing="0" cellpadding="0" border="0" style="margin: 0 auto;">
                                <tr>
                                    <td style="font-size: 24px; font-weight: 700; color: #24A197; letter-spacing: -0.5px;">QuickMedic</td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                    <tr>
                        <td style="padding: 40px 40px 20px;">
                            <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
                                <tr>
                                    <td style="font-size: 24px; font-weight: 600; color: #1a1a1a; line-height: 32px; padding-bottom: 10px;">New Support Request</td>
                                </tr>
                                <tr>
                                    <td style="font-size: 16px; color: #666666; line-height: 24px; padding-bottom: 30px;">A merchant has submitted a support request.</td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                    <tr>
                        <td style="padding: 0 40px 30px;">
                            <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
                                <tr>
                                    <td style="background-color: #f8f9fa; border: 1px solid #e9ecef; border-radius: 8px; padding: 20px;">
                                        <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
                                            <tr>
                                                <td style="font-size: 16px; font-weight: 600; color: #1a1a1a; padding-bottom: 16px;">Merchant Information</td>
                                            </tr>
                                            <tr>
                                                <td style="font-size: 14px; color: #666666; padding-bottom: 8px; line-height: 22px;"><strong style="color: #1a1a1a;">Name:</strong> {{merchantName}}</td>
                                            </tr>
                                            <tr>
                                                <td style="font-size: 14px; color: #666666; padding-bottom: 8px; line-height: 22px;"><strong style="color: #1a1a1a;">Email:</strong> <a href="mailto:{{merchantEmail}}" style="color: #24A197; text-decoration: none;">{{merchantEmail}}</a></td>
                                            </tr>
                                            <tr>
                                                <td style="font-size: 14px; color: #666666; line-height: 22px;"><strong style="color: #1a1a1a;">Merchant ID:</strong> {{merchantId}}</td>
                                            </tr>
                                        </table>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                    <tr>
                        <td style="padding: 0 40px 30px;">
                            <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
                                <tr>
                                    <td style="background-color: #f8f9fa; border: 1px solid #e9ecef; border-radius: 8px; padding: 20px;">
                                        <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
                                            <tr>
                                                <td style="font-size: 16px; font-weight: 600; color: #1a1a1a; padding-bottom: 12px;">Message Details</td>
                                            </tr>
                                            <tr>
                                                <td style="font-size: 14px; color: #666666; padding-bottom: 8px; line-height: 22px;"><strong style="color: #1a1a1a;">Subject:</strong> {{subject}}</td>
                                            </tr>
                                            <tr>
                                                <td style="font-size: 14px; color: #666666; padding-bottom: 8px; line-height: 22px;"><strong style="color: #1a1a1a;">Message:</strong></td>
                                            </tr>
                                            <tr>
                                                <td style="background-color: #ffffff; border: 1px solid #e9ecef; border-radius: 4px; padding: 16px; margin-top: 8px; font-size: 14px; color: #333333; line-height: 22px;">{{message}}</td>
                                            </tr>
                                        </table>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                    <tr>
                        <td style="padding: 0 40px 30px;">
                            <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
                                <tr>
                                    <td style="background-color: #24A197; border-radius: 4px; padding: 12px 16px; text-align: center;">
                                        <span style="font-size: 13px; color: #ffffff; font-weight: 500;">Submitted: {{timestamp}}</span>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                    <tr>
                        <td style="padding: 30px 40px; background-color: #f8f9fa; border-top: 1px solid #e9ecef; border-radius: 0 0 8px 8px;">
                            <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
                                <tr>
                                    <td style="font-size: 12px; color: #999999; text-align: center; line-height: 18px;">
                                        <p style="margin: 0;">This is an automated notification from the QuickMedic Merchant Platform.</p>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</body>
</html>
