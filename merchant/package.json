{
	"name": "merchant",
	"version": "1.0.0",
	"scripts": {
		"start": "npm run build && node dist/src/app.js",
		"dev": "nodemon --exec ts-node --project tsconfig.json src/app.ts",
		"build": "tsc --build && copyfiles -u 1 \"src/view/emails/**/*\" dist/",
		"build:watch": "tsc --watch",
		"seed": "ts-node --project tsconfig.json src/scripts/seed.ts"
	},
	"dependencies": {
		"@medtech/utils": "*",
		"axios": "^1.6.5",
		"cookie-parser": "^1.4.6",
		"copyfiles": "^2.4.1",
		"cors": "^2.8.5",
		"dotenv": "^16.0.0",
		"express": "^4.18.2",
		"express-rate-limit": "^7.1.5",
		"express-route-grouping": "^1.1.0",
		"helmet": "^7.1.0",
		"http-status": "^1.7.4",
		"joi": "^18.0.2",
		"pg": "^8.11.3",
		"pg-hstore": "^2.3.4",
		"sequelize": "^6.35.0",
		"sequelize-typescript": "^2.1.6",
		"swagger-jsdoc": "^6.2.8",
		"swagger-ui-express": "^5.0.0"
	},
	"devDependencies": {
		"@types/cookie-parser": "^1.4.6",
		"@types/cors": "^2.8.17",
		"@types/express": "^4.17.21",
		"@types/node": "^18.0.0",
		"@types/swagger-jsdoc": "^6.0.4",
		"@types/swagger-ui-express": "^4.1.6",
		"nodemon": "^3.1.9",
		"ts-node": "^10.9.0",
		"typescript": "^5.0.0"
	}
}
