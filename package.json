{
	"name": "medtech-monorepo",
	"version": "1.0.0",
	"private": true,
	"workspaces": {
		"packages": [
			"merchant",
			"experience_1",
			"utils"
		],
		"nohoist": []
	},
	"scripts": {
		"build": "npm run build:utils && npm run build:experience_1 && npm run build:merchant",
		"build:utils": "npx tsc -p utils/tsconfig.json",
		"build:experience_1": "npm run build --workspace=experience_1",
		"build:merchant": "npm run build --workspace=merchant",
		"start": "npm run start --workspace=merchant",
		"postinstall": "node -e \"if (process.env.RENDER === 'true') { require('child_process').execSync('npm run build', { stdio: 'inherit' }) }\""
	},
	"overrides": {
		"joi": "18.0.2",
		"@types/express": "^4.17.21",
		"@types/express-serve-static-core": "^4.19.0"
	},
	"resolutions": {
		"@types/express": "^4.17.21",
		"@types/express-serve-static-core": "^4.19.0"
	}
}
