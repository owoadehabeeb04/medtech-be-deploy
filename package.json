{
	"name": "medtech-monorepo",
	"version": "1.0.0",
	"private": true,
	"workspaces": {
		"packages": [
			"merchant",
			"experience_1",
			"utils"
		],
		"nohoist": []
	},
	"scripts": {
		"build": "npm run build:utils && npm run build:merchant && npm run build:experience_1",
		"build:utils": "npm run build --workspace=utils",
		"build:merchant": "npm run build --workspace=merchant",
		"build:experience_1": "npm run build --workspace=experience_1",
		"start": "npm run start --workspace=merchant",
		"start:combined": "node scripts/start-combined.mjs",
		"test:combined": "node --test scripts/tests/combined-deployment.test.mjs",
		"test:google-auth": "npm run build && node --test utils/tests/firebase-google-auth.test.cjs scripts/tests/firebase-google-login.test.cjs",
		"test:online-order-service-charge": "npm run build && node --test scripts/tests/online-order-service-charge.test.cjs",
		"postinstall": "node -e \"if (process.env.RENDER === 'true') { require('child_process').execSync('npm run build', { stdio: 'inherit' }) }\""
	},
	"overrides": {
		"joi": "18.0.2",
		"@types/express": "^4.17.21",
		"@types/express-serve-static-core": "^4.19.0"
	},
	"resolutions": {
		"@types/express": "^4.17.21",
		"@types/express-serve-static-core": "^4.19.0"
	}
}
