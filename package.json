{
	"name": "medtech-monorepo",
	"version": "1.0.0",
	"private": true,
	"workspaces": {
		"packages": [
			"merchant",
			"experience_1",
			"utils"
		],
		"nohoist": []
	},
	"scripts": {
		"build": "tsc -b tsconfig.build.json && npm exec -w merchant -- copyfiles \"src/view/emails/**/*\" dist/",
		"build:utils": "npm run build --workspace=utils",
		"build:merchant": "npm run build --workspace=merchant",
		"start": "npm run start --workspace=merchant",
		"postinstall": "node -e \"if (process.env.RENDER === 'true') { require('child_process').execSync('npm run build', { stdio: 'inherit' }) }\""
	},
	"overrides": {
		"joi": "18.0.2"
	}
}
